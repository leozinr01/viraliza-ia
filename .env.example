# Copie este arquivo para .env e preencha. NUNCA suba o .env pro GitHub.

# ===== Cloudflare R2 (onde ficam os vídeos) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=viraliza-cortes

# ===== Supabase =====
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA (Project Settings > API Keys > Secret keys). Só o worker usa.
SUPABASE_SECRET_KEY=
# Opcional: conexão direta com o banco (Connect > Session pooler)
SUPABASE_DB_URL=

# ===== Publicação nas redes (o worker usa pra renovar as conexões) =====
# Os mesmos valores vão também nos "secrets" da função conectar do Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# rascunho = vai pros rascunhos do app do TikTok (funciona sem auditoria); direto = publica na hora (depois da auditoria)
TIKTOK_MODO=rascunho
